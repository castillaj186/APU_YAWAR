# Mantiene cargados los chunks que contienen el bunker activo durante el reto.
# /forceload usa COORDENADAS DE CHUNK, no coordenadas de bloque.
execute if score #dest rj_k matches 2 in minecraft:overworld run forceload add 876 6 879 9
execute if score #dest rj_k matches 3 in minecraft:overworld run forceload add 886 -41 888 -38
execute if score #dest rj_k matches 4 in minecraft:overworld run forceload add 461 298 464 301
execute if score #dest rj_k matches 5 in minecraft:overworld run forceload add 94 157 97 161
